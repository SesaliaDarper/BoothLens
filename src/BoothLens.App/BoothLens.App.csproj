<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>BoothLens</AssemblyName>
    <Version>0.3.0</Version>
    <Product>BoothLens</Product>
    <Description>BoothLens 本地资源库服务</Description>
    <ApplicationIcon>../../assets/boothlens.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../BoothLens.Core/BoothLens.Core.csproj" />
    <Content Update="wwwroot/**/*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../unity/BoothRelay.cs" Link="unity/BoothRelay.cs" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <EmbeddedResource Include="../../unity/BoothRelay.cs" LogicalName="BoothLens.Unity.BoothRelay.cs" />
  </ItemGroup>
</Project>
