<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Start-BoothLens</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../../assets/boothlens.ico</ApplicationIcon>
    <Version>0.3.0</Version>
    <Product>BoothLens Desktop</Product>
    <Description>BoothLens 资源管理桌面软件</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4370.26" />
    <EmbeddedResource Include="../../assets/boothlens.ico" LogicalName="BoothLens.Icon" />
  </ItemGroup>
  <!-- WebView2 ships both UI bindings; this desktop shell uses WinForms only. -->
  <Target Name="RemoveUnusedWebViewWpf" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup><Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" /></ItemGroup>
  </Target>
</Project>
